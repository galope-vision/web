---
/**
 * The GALOPE logo. Full size at the bottom of every page, small on Info (docs/spec.md § 5.0,
 * § 5.4). The aspect ratio of the file is 321 × 40.
 */
interface Props {
  /** Width in pixels: 321 at the bottom of the page, 138 on Info. */
  width?: number;
}

const { width = 321 } = Astro.props;
const height = Math.round((width * 40) / 321);
---

<img class="logo" src="/img/logo-galope.svg" width={width} height={height} alt="GALOPE" />

<style>
  .logo {
    max-width: 100%;
    height: auto;
  }
</style>
