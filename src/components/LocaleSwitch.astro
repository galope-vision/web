---
/**
 * The `ES/EN` item of the nav: the current locale is marked, the other one links to the same
 * page (docs/spec.md § 5.0).
 */
import { LOCALES, LOCALE_LABELS, localeVariants, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const variants = localeVariants(Astro.url.pathname);
const s = t(locale);
---

<nav class="locales" aria-label={s('nav.language')}>
  {LOCALES.map((item, index) => (
    <Fragment>
      {index > 0 && (
        <span class="separator" aria-hidden="true">
          /
        </span>
      )}
      {item === locale ? (
        <span class="current" aria-current="true">
          {LOCALE_LABELS[item]}
        </span>
      ) : (
        <a href={variants[item]} hreflang={item}>
          {LOCALE_LABELS[item]}
        </a>
      )}
    </Fragment>
  ))}
</nav>

<style>
  .locales {
    display: flex;
    font-weight: var(--fw-bold);
  }

  .current {
    color: var(--color-accent-text);
    text-decoration: underline;
  }

  a {
    text-decoration: none;
  }
</style>
