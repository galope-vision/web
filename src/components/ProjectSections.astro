---
/**
 * The Fotos, Vídeos and Proceso sections under the collage, with every image and video of the
 * project — the collage itself shows at most 8 (docs/spec.md § 5.3).
 *
 * PROVISIONAL layout. How these sections look is still an open decision (CLAUDE.md), so this is
 * the plain reading of the spec: a heading and everything in it, one column on a narrow screen
 * and two where there is room. The ids are what the "Partes del proyecto" links scroll to, and
 * those are fixed; the design on top of them is not.
 */
import { Image } from 'astro:assets';
import VideoEmbed from './VideoEmbed.astro';
import { t, type Locale } from '../lib/i18n';
import type { ProjectData } from '../lib/content';

/** A gallery image and its place in the gallery, which is also its place in the viewer. */
type GalleryItem = ProjectData['gallery'][number] & { index: number };

interface Props {
  locale: Locale;
  title: string;
  fotos: GalleryItem[];
  videos: string[];
  proceso: GalleryItem[];
}

const { locale, title, fotos, videos, proceso } = Astro.props;
const s = t(locale);
---

{fotos.length > 0 && (
  <section class="section" id="fotos" aria-labelledby="fotos-heading">
    {/*
      Hidden to the eye only: right under the collage, the same photos with "Fotos" over them
      read as a repeat of the panel's link. Screen readers still get the heading, and the
      link still lands on the section.
    */}
    <h2 id="fotos-heading" class="visually-hidden">
      {s('project.photos')}
    </h2>
    <div class="grid" data-enter-group>
      {fotos.map((item) => (
        <button
          type="button"
          class="open"
          data-enter
          data-viewer-open={item.index}
          aria-label={`${s('viewer.open')}: ${item.alt}`}
        >
          <Image
            class="image"
            src={item.image}
            alt=""
            widths={[480, 960]}
            sizes="(width >= 48rem) 50vw, 100vw"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  </section>
)}

{videos.length > 0 && (
  <section class="section" id="videos" aria-labelledby="videos-heading">
    <h2 id="videos-heading">{s('project.videos')}</h2>
    <div class="grid" data-enter-group>
      {videos.map((url, index) => (
        <div data-enter>
          <VideoEmbed url={url} title={`${title} — ${s('project.video')} ${index + 1}`} />
        </div>
      ))}
    </div>
  </section>
)}

{proceso.length > 0 && (
  <section class="section" id="proceso" aria-labelledby="proceso-heading">
    <h2 id="proceso-heading">{s('project.process')}</h2>
    <div class="grid" data-enter-group>
      {proceso.map((item) => (
        <button
          type="button"
          class="open"
          data-enter
          data-viewer-open={item.index}
          aria-label={`${s('viewer.open')}: ${item.alt}`}
        >
          <Image
            class="image"
            src={item.image}
            alt=""
            widths={[480, 960]}
            sizes="(width >= 48rem) 50vw, 100vw"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  </section>
)}

<style>
  .section {
    display: grid;
    gap: var(--space-2);
    /* The anchor links land here, so the heading must not end up under the nav row. */
    scroll-margin-top: var(--space-3);
  }

  .grid {
    display: grid;
    gap: var(--space-gutter);
    grid-template-columns: 1fr;
  }

  @media (width >= 48rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* "Menos info": the whole width, like the collage above, on the page's four columns. */
    :global([data-info='less']) .grid {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }
  }

  /*
   * Whole images, not crops: these sections are where someone goes to actually look at the
   * photo. `focus` is the collage's business — it only means something where an image is cut
   * to a cell, and here nothing is cut, so `object-fit` would be dead CSS.
   */
  .image {
    width: 100%;
    height: auto;
  }

  /*
   * Each photo is a button that opens it full screen (Viewer.astro). The alt text moves to the
   * button's name, after "Ver en pantalla completa", so it is still read once.
   */
  .open {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }
</style>
