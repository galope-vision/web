---
/**
 * A project page: the info panel, the collage, and the Fotos, Vídeos and Proceso sections
 * (docs/spec.md § 5.3). Shared by `/proyectos/[slug]` and `/en/projects/[slug]`.
 *
 * From 48rem up the page is two columns: the panel on the left, pinned while the page scrolls,
 * and the collage with the sections under it on the right, as in the Figma — the photos never
 * go under the text. Pinning the panel is what keeps "Partes del proyecto" in view, so the part
 * being read can be marked in it (ProjectPanel.astro). Below 48rem everything is one column:
 * the panel, the collage, the sections. The collage takes the first 8 images of the gallery in
 * order; the rest appear only in the sections.
 *
 * Which parts exist is worked out once, here, so the links in the panel and the sections below
 * can never disagree about whether a part is empty.
 */
import Collage from './Collage.astro';
import ProjectPanel from './ProjectPanel.astro';
import ProjectSections from './ProjectSections.astro';
import Viewer from './Viewer.astro';
import { t, type Locale } from '../lib/i18n';
import { collageItems, collageSeed } from '../lib/content';
import type { Project, ProjectPart } from '../lib/content';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const { data } = project;
const s = t(locale);

/*
 * Every photo keeps its place in the gallery, which is also its place in the full-screen viewer:
 * the collage (the gallery's first images, in order) and the sections open the same one.
 */
const indexed = data.gallery.map((item, index) => ({ ...item, index }));
const fotos = indexed.filter((item) => item.part === 'fotos');
const proceso = indexed.filter((item) => item.part === 'proceso');
const collage = collageItems(project).map((item, index) =>
  data.gallery.length > 0 ? { ...item, viewer: index } : item,
);

/** A part with nothing in it gets no link, as the spec asks. */
const parts: ProjectPart[] = [
  fotos.length > 0 && { id: 'fotos', label: s('project.photos') },
  data.videos.length > 0 && { id: 'videos', label: s('project.videos') },
  proceso.length > 0 && { id: 'proceso', label: s('project.process') },
].filter((part): part is ProjectPart => part !== false);
---

<div class="detail" data-info="more">
  <ProjectPanel locale={locale} data={data} parts={parts} />
  <div class="content">
    <Collage items={collage} seed={collageSeed(project)} />
    <ProjectSections
      locale={locale}
      title={data.title}
      fotos={fotos}
      videos={data.videos}
      proceso={proceso}
    />
  </div>
</div>
<Viewer locale={locale} gallery={data.gallery} />

<style>
  /*
   * `minmax(0, 1fr)` on both grids: an implicit track is as wide as its widest content, and the
   * collage and the sections would rather be wider than the page, which gave every project page
   * a horizontal scroll. A track that may shrink to zero takes the width it is given.
   */
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding-bottom: var(--space-4);
  }

  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-content: start;
    min-width: 0;
  }

  /*
   * The panel does not start below the dice; it clears it sideways. In the design (1366 × 768)
   * the panel is 340 wide at x = 18 and the dice starts at x = 629, so they never meet
   * horizontally and the panel begins at the top. See ProjectPanel.astro for the width.
   *
   * The panel's column stretches down the whole page, which is what gives it room to stay
   * pinned while the collage and the sections scroll past.
   */
  @media (width >= 48rem) {
    .detail {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0 var(--space-gutter);
      padding-top: var(--space-1);
    }

    /*
     * "Menos info" (set by ProjectPanel.astro): one column, so the collage takes the whole
     * screen, and what is left of the panel — the title and the two actions — stays pinned
     * over it, in the corners the collage keeps free (src/lib/collage.ts, FULL). The panel
     * lets the pointer through to the photos everywhere but on its own text.
     *
     * The sections below follow it and take the whole width too (ProjectSections.astro puts
     * them on four columns), so the whole page rearranges, not only the collage. Photos do pass
     * under the title, Más Info and VOLVER as the page scrolls, so those carry a halo of the
     * page's black to stay readable (ProjectPanel.astro).
     */
    .detail[data-info='less'] {
      grid-template-columns: minmax(0, 1fr);
    }

    .detail[data-info='less'] > :global(.panel) {
      grid-area: 1 / 1;
      z-index: 1;
      pointer-events: none;
    }

    .detail[data-info='less'] > :global(.panel > *) {
      pointer-events: auto;
    }

    .detail[data-info='less'] > .content {
      grid-area: 1 / 1;
    }
  }
</style>
