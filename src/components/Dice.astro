---
/**
 * The GALOPE dice, under the nav (docs/spec.md § 5.0).
 *
 * `placement` picks between its two positions:
 * - `nav` pins it under the nav row, as on every built page. There it is a link: it goes to a
 *   project picked at random out of the ones with `inDice: true`.
 * - `hero` puts it in the flow, larger, for the holding page (src/components/ComingSoon.astro).
 *   There it goes nowhere, because none of the pages it could lead to are built yet.
 *
 * The draw is the visitor's, not the build's: the candidates ship in the HTML and the script
 * picks one per click, so two clicks can give two different projects. Without JavaScript the
 * link still works and leads to the projects list — the dice always goes somewhere.
 *
 * The spin on click belongs to phase 4, with the rest of the motion.
 */
import { Image } from 'astro:assets';
import dice from '../assets/dado.png';
import { getProjects } from '../lib/content';
import { localePath, t, type Locale } from '../lib/i18n';

interface Props {
  placement?: 'nav' | 'hero';
  /** Required by `nav`, which is the placement that navigates. */
  locale?: Locale;
}

const { placement = 'nav', locale } = Astro.props;

/** 91 × 96 is the size in the design; the holding page is the one place it gets to be big. */
const width = placement === 'hero' ? 182 : 91;
const height = Math.round((width * 96) / 91);

const projects = placement === 'nav' && locale ? await getProjects(locale) : [];
const targets = projects
  .filter((project) => project.data.inDice)
  .map((project) => localePath(locale ?? 'es', 'projects', project.slug));

const interactive = locale !== undefined && targets.length > 0;
const s = locale ? t(locale) : undefined;
---

{interactive && locale && s ? (
  <a
    class="link nav"
    href={localePath(locale, 'projects')}
    aria-label={s('dice.label')}
    data-dice={JSON.stringify(targets)}
  >
    <Image
      class="dice"
      src={dice}
      alt=""
      width={width}
      height={height}
      densities={[1, 2]}
      loading="eager"
    />
  </a>
) : (
  <Image
    class:list={['dice', placement]}
    src={dice}
    alt=""
    width={width}
    height={height}
    densities={[1, 2]}
    loading="eager"
  />
)}

<script>
  for (const dice of document.querySelectorAll<HTMLAnchorElement>('[data-dice]')) {
    let targets: string[] = [];
    try {
      targets = JSON.parse(dice.dataset.dice ?? '[]') as string[];
    } catch {
      targets = [];
    }

    if (targets.length > 0) {
      dice.addEventListener('click', (event) => {
        /*
         * Landing back where you already are is not much of a surprise, so the project being
         * read is taken out of the draw — unless it is the only one there is.
         */
        const here = window.location.pathname.replace(/\/$/, '');
        const elsewhere = targets.filter((target) => target.replace(/\/$/, '') !== here);
        const pool = elsewhere.length > 0 ? elsewhere : targets;
        const choice = pool[Math.floor(Math.random() * pool.length)];

        if (choice) {
          event.preventDefault();
          window.location.href = choice;
        }
      });
    }
  }
</script>

<style>
  .dice {
    width: var(--size-dice-width);
    height: var(--size-dice-height);
  }

  .link {
    display: block;
    line-height: 0;
  }

  .nav {
    position: absolute;
    top: var(--size-dice-top);
    left: 50%;
    transform: translateX(-50%);
  }

  /* On a narrow screen the nav fills the row, so the dice goes under it instead of over it. */
  @media (width < 48rem) {
    .nav {
      top: calc(var(--size-header-height) + var(--space-1));
    }
  }

  .hero {
    width: calc(var(--size-dice-width) * 2);
    max-width: 60vw;
    height: auto;
  }

  /*
   * Every dice wobbles, not just the holding page's. It is the `rotate` property rather than a
   * `transform`, because the pinned one is centred with `translateX(-50%)` and a `transform`
   * animation would overwrite that and drag it off centre. `rotate` composes with it, and is
   * composited the same way.
   */
  .dice,
  .link {
    animation: wobble 6s var(--ease-out) infinite;
    will-change: rotate;
  }

  /* The image inside the link is carried by the link; it must not wobble twice as hard. */
  .link .dice {
    animation: none;
    will-change: auto;
  }

  /*
   * Still for most of the loop, then a short wobble: all of the movement happens in the last
   * 12% of the 6 s. This is the dice wobble of CLAUDE.md, not the idle drift, so it is wider
   * than the ±0.6° that drift gets; phase 4 settles the exact figure against the design.
   */
  @keyframes wobble {
    0%,
    88% {
      rotate: 0deg;
    }
    91% {
      rotate: -2deg;
    }
    94% {
      rotate: 1.6deg;
    }
    97% {
      rotate: -0.8deg;
    }
    100% {
      rotate: 0deg;
    }
  }

  /* No idle motion when the visitor asked for less (global.css also clamps the duration). */
  @media (prefers-reduced-motion: reduce) {
    .dice,
    .link {
      animation: none;
      will-change: auto;
    }
  }
</style>
