---
/**
 * The GALOPE dice, under the nav (docs/spec.md § 5.0).
 *
 * `placement` picks between its two positions:
 * - `nav` pins it under the nav row, as on every built page. There it is a link: it goes to a
 *   project picked at random out of the ones with `inDice: true`.
 * - `hero` puts it in the flow, larger, for the holding page (src/components/ComingSoon.astro).
 *   There it goes nowhere, because none of the pages it could lead to are built yet.
 *
 * The dice is the design team's own animation (Galope_Dado.gif), rendered, not rebuilt: an
 * animated WebP keeps the texture of the faces as they drew it. The files in public/img/dado/
 * are cut from the export's frames: a square centred on the dice at rest that holds every frame,
 * at 1x and 2x, WebP quality 80 (the grain of the texture, not the quality setting, is what
 * weighs). It comes in two cuts:
 * - `rueda`, for the holding page: it rolls all the time, as in the GIF.
 * - `pausa`, for the nav: the same roll after 3 s at rest on G, L and P — the "every ~6 s" of the
 *   spec. The pause is in the file itself, so no script keeps time.
 * With reduced motion a <source> swaps either of them for `quieto`, the resting frame.
 *
 * **The page loads with `quieto` and switches to the animation afterwards.** The animated files
 * weigh 0.5–1.7 MB against 4–31 KB for the still frame, and they were on every page: the dice
 * was the page's Largest Contentful Paint, or took the bandwidth the real one needed. The
 * `<img>` therefore starts on `quieto`, which is also the first frame of both cuts (the roll
 * starts and ends at rest), and the script below puts the animated `srcset` in once the page
 * has loaded and the browser is idle, decoding it first so the switch never shows a blank.
 * Without JavaScript the dice stays still, which is what reduced motion gets anyway.
 *
 * The draw is the visitor's, not the build's: the candidates ship in the HTML and the script
 * picks one per click, so two clicks can give two different projects. Without JavaScript the
 * link still works and leads to the projects list — the dice always goes somewhere.
 *
 * On click it spins — two turns with a small swell, about 0.7 s — and only then goes. With
 * reduced motion it goes straight away. A click with a modifier key, or with any button other
 * than the main one, is left to the browser, so "open in a new tab" still works on the link.
 */
import { getProjects } from '../lib/content';
import { localePath, t, type Locale } from '../lib/i18n';

interface Props {
  placement?: 'nav' | 'hero';
  /** Required by `nav`, which is the placement that navigates. */
  locale?: Locale;
}

const { placement = 'nav', locale } = Astro.props;

/*
 * The frames are square and leave room for the dice to roll; at rest it fills the 91 × 96 box of
 * the design, and the frame spills a little past it on every side. Sizes are the frame's side in
 * CSS pixels, at 1x and 2x.
 */
const DIR = '/img/dado';
const side = placement === 'hero' ? 198 : 99;
const cut = placement === 'hero' ? 'rueda' : 'pausa';
const srcset = (name: string): string =>
  `${DIR}/dado-${name}-${side}.webp 1x, ${DIR}/dado-${name}-${side * 2}.webp 2x`;

const projects = placement === 'nav' && locale ? await getProjects(locale) : [];
const targets = projects
  .filter((project) => project.data.inDice)
  .map((project) => localePath(locale ?? 'es', 'projects', project.slug));

const interactive = locale !== undefined && targets.length > 0;
const s = locale ? t(locale) : undefined;
---

{interactive && locale && s ? (
  <a
    class="link nav"
    href={localePath(locale, 'projects')}
    aria-label={s('dice.label')}
    data-dice={JSON.stringify(targets)}
  >
    <span class="box">
      <picture>
        <source
          media="(prefers-reduced-motion: reduce)"
          srcset={srcset('quieto')}
          type="image/webp"
        />
        <img
          class="dice"
          src={`${DIR}/dado-quieto-${side}.webp`}
          srcset={srcset('quieto')}
          data-animated={srcset(cut)}
          alt=""
          width={side}
          height={side}
          loading="eager"
        />
      </picture>
    </span>
  </a>
) : (
  <span class:list={['box', placement]}>
    <picture>
      <source
        media="(prefers-reduced-motion: reduce)"
        srcset={srcset('quieto')}
        type="image/webp"
      />
      <img
        class="dice"
        src={`${DIR}/dado-quieto-${side}.webp`}
        srcset={srcset('quieto')}
        data-animated={srcset(cut)}
        alt=""
        width={side}
        height={side}
        loading="eager"
      />
    </picture>
  </span>
)}

<script>
  import { animate } from 'motion/mini';

  /*
   * The animation goes in after the page has loaded (see the top of this file). Not under
   * reduced motion: there the <source> shows `quieto` whatever the `<img>` holds, so there is
   * nothing to gain from downloading it.
   */
  function animateDice(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const image of document.querySelectorAll<HTMLImageElement>('img[data-animated]')) {
      const srcset = image.dataset.animated;
      if (!srcset) continue;
      const next = new Image();
      next.sizes = image.sizes;
      next.srcset = srcset;
      void next
        .decode()
        .catch(() => undefined)
        .then(() => {
          image.srcset = srcset;
        });
    }
  }

  const idle = (): void => {
    if ('requestIdleCallback' in window) window.requestIdleCallback(animateDice, { timeout: 2000 });
    else setTimeout(animateDice, 200);
  };
  if (document.readyState === 'complete') idle();
  else window.addEventListener('load', idle, { once: true });

  /* docs/spec.md § 5.0: "al hacer click gira y navega". Transform only, as § 8 asks. */
  const SPIN = 0.7;
  /* If the spin never finishes (a hidden tab stops animations), go anyway. */
  const LATEST = 1000;

  function reduced(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  for (const dice of document.querySelectorAll<HTMLAnchorElement>('[data-dice]')) {
    let targets: string[] = [];
    try {
      targets = JSON.parse(dice.dataset.dice ?? '[]') as string[];
    } catch {
      targets = [];
    }

    const image = dice.querySelector<HTMLElement>('.dice');
    let rolling = false;

    if (targets.length > 0) {
      dice.addEventListener('click', (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        /*
         * Landing back where you already are is not much of a surprise, so the project being
         * read is taken out of the draw — unless it is the only one there is.
         */
        const here = window.location.pathname.replace(/\/$/, '');
        const elsewhere = targets.filter((target) => target.replace(/\/$/, '') !== here);
        const pool = elsewhere.length > 0 ? elsewhere : targets;
        const choice = pool[Math.floor(Math.random() * pool.length)];
        if (!choice) return;

        event.preventDefault();
        if (rolling) return;
        rolling = true;

        const go = (): void => {
          window.location.href = choice;
        };

        if (!image || reduced()) {
          go();
          return;
        }

        const spin = animate(
          image,
          {
            transform: [
              'rotate(0deg) scale(1)',
              'rotate(300deg) scale(1.15)',
              'rotate(620deg) scale(0.95)',
              'rotate(720deg) scale(1)',
            ],
          },
          { duration: SPIN, ease: [0.22, 1, 0.36, 1] },
        );
        void Promise.race([spin, new Promise((resolve) => setTimeout(resolve, LATEST))]).then(go);
      });
    }
  }
</script>

<style>
  /* The box the dice takes in the layout: 91 × 96 in the design, twice that on the holding page. */
  .box {
    position: relative;
    display: block;
    width: var(--size-dice-width);
    height: var(--size-dice-height);
  }

  .hero {
    width: min(calc(var(--size-dice-width) * 2), 60vw);
    height: auto;
    aspect-ratio: 91 / 96;
  }

  /* The frame, centred on the box and a little larger than it (see the comment at the top). */
  .dice {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(100% * var(--ratio-dice-frame));
    max-width: none;
    height: auto;

    /* `translate`, not `transform`: the spin on click animates the transform and keeps this. */
    translate: -50% -50%;
  }

  .link {
    display: block;
    line-height: 0;
  }

  /*
   * Above the page's content: the collages start at the top of the page, and although they
   * keep the cells under the dice empty, their boxes still covered it and took its clicks.
   */
  .nav {
    position: absolute;
    z-index: 3;
    top: var(--size-dice-top);
    left: 50%;
    transform: translateX(-50%);
  }

  /*
   * The nav's dice lands after the nav row: it grows in from a little smaller with a quarter of
   * a turn undone, like a throw coming to rest. On the box, so it composes with the spin on
   * click (the image's transform) and the centring (the link's transform). The holding page's
   * dice is left alone: it is already rolling.
   */
  .nav .box {
    animation: dice-in var(--dur-base) var(--ease-out) calc(var(--dur-stagger) * 4) backwards;
  }

  @keyframes dice-in {
    from {
      opacity: 0;
      scale: 0.8;
      rotate: -12deg;
    }
  }

  /* On a narrow screen the nav fills the row, so the dice goes under it instead of over it. */
  @media (width < 48rem) {
    .nav {
      top: calc(var(--size-header-height) + var(--space-1));
    }
  }
</style>
