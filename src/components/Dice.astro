---
/**
 * The GALOPE dice, under the nav (docs/spec.md § 5.0). It still does nothing: phase 3 makes it
 * go to a random project and phase 4 adds the spin on click.
 *
 * `placement` picks between the two positions it has so far:
 * - `nav` pins it under the nav row, as on every built page.
 * - `hero` puts it in the flow, larger and wobbling, for the holding page
 *   (src/components/ComingSoon.astro). The wobble is the ~6 s one from CLAUDE.md, in pure CSS;
 *   phase 4 generalises it to every page along with the rest of the motion.
 */
import { Image } from 'astro:assets';
import dice from '../assets/dado.png';

interface Props {
  placement?: 'nav' | 'hero';
}

const { placement = 'nav' } = Astro.props;
/** 91 × 96 is the size in the design; the holding page is the one place it gets to be big. */
const width = placement === 'hero' ? 182 : 91;
const height = Math.round((width * 96) / 91);
---

<Image
  class:list={['dice', placement]}
  src={dice}
  alt=""
  width={width}
  height={height}
  densities={[1, 2]}
  loading="eager"
/>

<style>
  .dice {
    width: var(--size-dice-width);
    height: var(--size-dice-height);
  }

  .nav {
    position: absolute;
    top: var(--size-dice-top);
    left: 50%;
    transform: translateX(-50%);
  }

  /* On a narrow screen the nav fills the row, so the dice goes under it instead of over it. */
  @media (width < 48rem) {
    .nav {
      top: calc(var(--size-header-height) + var(--space-1));
    }
  }

  .hero {
    width: calc(var(--size-dice-width) * 2);
    max-width: 60vw;
    height: auto;
    animation: wobble 6s var(--ease-out) infinite;
    /* The animation only touches `transform`, so it stays on the compositor. */
    will-change: transform;
  }

  /*
   * Still for most of the loop, then a short wobble: all of the movement happens in the last
   * 12% of the 6 s. This is the dice wobble of CLAUDE.md, not the idle drift, so it is wider
   * than the ±0.6° that drift gets; phase 4 settles the exact figure against the design.
   */
  @keyframes wobble {
    0%,
    88% {
      transform: rotate(0deg);
    }
    91% {
      transform: rotate(-2deg);
    }
    94% {
      transform: rotate(1.6deg);
    }
    97% {
      transform: rotate(-0.8deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  /* No idle motion when the visitor asked for less (global.css also clamps the duration). */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      animation: none;
      will-change: auto;
    }
  }
</style>
