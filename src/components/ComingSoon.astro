---
/**
 * The holding page the domain shows until the real home is built: the dice, the title, one line
 * and whatever socials `ajustes/general.yml` has.
 *
 * Temporary by design. When phase 3 builds the real home (the random images or video of
 * docs/spec.md § 5.1), this component and its `soon.*` strings go away, and `src/pages/index.astro`
 * and `src/pages/en/index.astro` drop back to `chrome="full" dice="nav"`.
 *
 * The dice is decorative here: it is not a link, because there are no projects to send anyone to
 * yet. Phase 3 is what makes it clickable.
 */
import Dice from './Dice.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  socials: readonly { label: string; url: string }[];
}

const { locale, socials } = Astro.props;
const s = t(locale);
---

<div class="soon">
  <Dice placement="hero" />
  <h1 class="title">{s('soon.title')}</h1>
  <p class="body">{s('soon.body')}</p>
  {socials.length > 0 && (
    <p class="socials">
      <span class="lead">{s('soon.follow')}</span>
      {socials.map(({ label, url }) => (
        <a href={url} rel="me noopener" target="_blank">
          {label}
        </a>
      ))}
    </p>
  )}
</div>

<style>
  .soon {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    min-height: 100%;
    padding: var(--space-3) 0;
    text-align: center;
  }

  .title {
    /* Uppercase in the design, lower case in the markup, so it is read out normally. */
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .body {
    max-width: 32ch;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    font-size: var(--fs-nav);
    line-height: var(--lh-nav);
  }

  .lead {
    color: var(--color-placeholder);
  }

  .socials a {
    font-weight: var(--fw-bold);
    text-decoration: none;
  }

  /* The title and the dice carry the page; the gap can be tighter on a phone. */
  @media (width < 48rem) {
    .soon {
      gap: var(--space-1);
      padding: var(--space-2) 0;
    }
  }
</style>
