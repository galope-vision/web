---
/**
 * The holding page the domain shows until the real home is built: the dice, the date the site
 * goes live and the Instagram link.
 *
 * Temporary by design. When phase 3 builds the real home (the random images or video of
 * docs/spec.md § 5.1), this component and its `soon.*` strings go away, and `src/pages/index.astro`
 * and `src/pages/en/index.astro` drop back to `chrome="full" dice="nav"`.
 *
 * The dice is decorative here: it is not a link, because there are no projects to send anyone to
 * yet. Phase 3 is what makes it clickable.
 */
import Dice from './Dice.astro';

interface Props {
  socials: readonly { label: string; url: string }[];
}

const { socials } = Astro.props;

/**
 * The day the site goes live. Written once, here: the page shows it as DD/MM/YYYY in both
 * locales (that is the design), and `<time>` carries the ISO form for machines.
 */
const LAUNCH_DATE = '2026-12-20';
const [year, month, day] = LAUNCH_DATE.split('-');
const launchLabel = `${day}/${month}/${year}`;

/**
 * Only Instagram belongs on the holding page, whatever else `ajustes/general.yml` lists:
 * the rest of the socials wait for the Contacto page.
 */
const instagram = socials.find(({ url }) => {
  try {
    const { hostname } = new URL(url);
    return hostname === 'instagram.com' || hostname.endsWith('.instagram.com');
  } catch {
    return false;
  }
});

/**
 * The page shows the handle, not the word "Instagram", and reads it off the URL so the CMS stays
 * the single place the account is written down. `/ga.lo.pe/` -> `@ga.lo.pe`; anything without a
 * handle in it falls back to the label.
 */
const handle = (() => {
  if (!instagram) return undefined;
  const name = new URL(instagram.url).pathname.split('/').filter(Boolean)[0];
  return name === undefined ? instagram.label : `@${name}`;
})();
---

<div class="soon">
  <Dice placement="hero" />
  <h1 class="date">
    <time datetime={LAUNCH_DATE}>{launchLabel}</time>
  </h1>
  {instagram && (
    <p class="social">
      <a
        href={instagram.url}
        rel="me noopener"
        target="_blank"
        aria-label={`${instagram.label}: ${handle}`}
      >
        {handle}
      </a>
    </p>
  )}
</div>

<style>
  .soon {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    min-height: 100%;
    padding: var(--space-3) 0;
    text-align: center;
  }

  .date {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: 0.08em;
  }

  .social {
    font-size: var(--fs-nav);
    line-height: var(--lh-nav);
  }

  .social a {
    font-weight: var(--fw-bold);
    text-decoration: none;
  }

  /* The date and the dice carry the page; the gap can be tighter on a phone. */
  @media (width < 48rem) {
    .soon {
      gap: var(--space-1);
      padding: var(--space-2) 0;
    }
  }
</style>
