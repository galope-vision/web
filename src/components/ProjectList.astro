---
/**
 * The list on `/proyectos` and the collage behind it (docs/spec.md § 5.2).
 *
 * Projects are grouped by `group` with a space between groups, one row each showing the title
 * and, in a second column, the type in parentheses. Hovering a row, or reaching it with the
 * keyboard, turns it red and underlined and fades that project's collage in over the general
 * one in 200 ms.
 *
 * The general collage is the covers of every project; each project's own collage is the same
 * one its page shows, from the same seed.
 *
 * **Why the per-project collages sit in `<template>`.** There is one per project, each with up
 * to eight images. With the catalogue in docs/spec.md § 6.4 that is about eighty images on a
 * page where at most one set is ever seen, and they are all inside the viewport, so `lazy`
 * would not hold any of them back. Inside a `<template>` nothing is rendered and nothing is
 * fetched until the script clones it, which happens the first time a row is pointed at. With no
 * JavaScript there is no swap at all: the general collage and the list work as they are.
 */
import Collage from './Collage.astro';
import { collageItems, collageSeed, groupProjects, type Project } from '../lib/content';
import { localePath, typeLabel, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  projects: Project[];
}

const { locale, projects } = Astro.props;
const groups = groupProjects(projects);

/** The general collage: one cover per project, in the order the list shows them. */
const covers = projects.map(({ data }) => ({
  image: data.cover,
  alt: '',
  focus: 'center' as const,
}));

/** Stable while the catalogue is, so the backdrop only changes when the projects do. */
const generalSeed = projects.map(({ slug }) => slug).join('-');
---

<div class="stage">
  <div class="collages">
    <Collage items={covers} seed={generalSeed} />
    {projects.map((project) => (
      <div class="swap" data-slug={project.slug}>
        <template>
          <Collage items={collageItems(project)} seed={collageSeed(project)} />
        </template>
      </div>
    ))}
  </div>

  <div class="list">
    {groups.map(({ group, projects: inGroup }) => (
      <ul class="group" data-group={group}>
        {inGroup.map(({ slug, data }) => (
          <li>
            {/*
              The space between the two spans is deliberate: without it the accessible name of
              the link runs the title into the type — "111 (Documental)(Documental)". A
              white-space-only text node is not rendered as a grid item, so the row stays two
              columns wide.
            */}
            <a class="row" href={localePath(locale, 'projects', slug)} data-slug={slug}>
              <span class="title">{data.title}</span>{' '}
              <span class="type">({typeLabel(locale, data.type)})</span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('.stage');

  if (stage) {
    const swaps = new Map(
      [...stage.querySelectorAll<HTMLElement>('.swap')].map((element) => [
        element.dataset.slug ?? '',
        element,
      ]),
    );

    /** Clones the collage the first time it is asked for; after that it is already there. */
    function reveal(slug: string): void {
      const swap = swaps.get(slug);
      const template = swap?.querySelector('template');
      if (swap && template) {
        swap.append(template.content.cloneNode(true));
        template.remove();
      }
      for (const [key, element] of swaps) element.classList.toggle('is-visible', key === slug);
    }

    function clear(): void {
      for (const element of swaps.values()) element.classList.remove('is-visible');
    }

    for (const row of stage.querySelectorAll<HTMLElement>('.row')) {
      const { slug } = row.dataset;
      if (!slug) continue;
      /* Pointer and keyboard get the same treatment, which is the rule in CLAUDE.md. */
      row.addEventListener('mouseenter', () => reveal(slug));
      row.addEventListener('focus', () => reveal(slug));
      row.addEventListener('mouseleave', clear);
      row.addEventListener('blur', clear);
    }
  }
</script>

<style>
  /* The list is drawn over the collage; both are the one grid cell. */
  .stage {
    display: grid;
  }

  .stage > * {
    grid-area: 1 / 1;
  }

  .collages {
    display: grid;
  }

  .collages > :global(*) {
    grid-area: 1 / 1;
  }

  /*
   * A project's collage fades in over the general one and is not there for anybody until it
   * does. `prefers-reduced-motion` turns the transition off globally (src/styles/global.css),
   * which leaves the swap instant rather than absent.
   */
  .swap {
    opacity: 0;
    transition: opacity var(--dur-swap) var(--ease-out);
  }

  .swap.is-visible {
    opacity: 1;
  }

  /*
   * The list sits on the left, in the first two of the four grid columns, because the collage
   * is behind it and needs the rest of the width. On a narrow screen the grid is two columns
   * wide and the list takes all of it.
   */
  .list {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    width: 100%;
    /* Above the collage, which is the first child of the cell. */
    position: relative;
  }

  /*
   * The dice is pinned over the content, centred, and the right-hand column of a row runs
   * straight into it. The collage reserves the dice and logo zones (CLAUDE.md); the list
   * reserves the same zone by starting below it. Narrow screens already get this from
   * `.dice-nav .main` in Base.astro, so the rule only applies once the dice moves over the
   * content.
   *
   * PROVISIONAL: the clearance is derived from the dice box, not read off the design. Worth
   * checking against Figma when the collage zone is solved properly.
   */
  @media (width >= 48rem) {
    .list {
      width: calc(
        (100% - (var(--grid-columns) - 1) * var(--space-gutter)) / var(--grid-columns) * 2 +
          var(--space-gutter)
      );
      padding-top: calc(var(--size-dice-top) + var(--size-dice-height) + var(--space-2));
    }
  }

  .group {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-gutter);
    padding: 2px 0;
    line-height: var(--lh-body);
    text-decoration: none;
  }

  .title {
    font-weight: var(--fw-bold);
    min-width: 0;
  }

  .type {
    font-weight: var(--fw-regular);
    white-space: nowrap;
  }

  /*
   * Red and underlined is the active state of a row, and the keyboard gets it on the same
   * terms as the mouse. The global `:focus-visible` outline stays on top of it: the colour
   * carries the design, the outline carries the "this is where you are".
   */
  .row:hover,
  .row:focus-visible {
    color: var(--color-accent-text);
    text-decoration: underline;
  }
</style>
