---
/** Placeholder home page until phase 2 builds the real one (docs/spec.md § 5.1). */
import LocaleSwitch from './LocaleSwitch.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<header class="bar">
  <LocaleSwitch locale={locale} />
</header>

<main class="placeholder">
  <h1 class="wordmark">GALOPE</h1>
  <p class="note">{s('home.underConstruction')}</p>
</main>

<style>
  .bar {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-2);
  }

  .placeholder {
    display: grid;
    place-content: center;
    gap: var(--space-2);
    min-height: 80svh;
    padding: var(--space-2);
    text-align: center;
  }

  .wordmark {
    font-size: var(--fs-wordmark);
    color: var(--color-accent);
    letter-spacing: var(--tracking-display);
  }

  .note {
    font-size: var(--fs-sm);
    color: var(--color-surface);
  }
</style>
