---
/**
 * The info panel of a project page: title, description, the links to the parts below, the
 * credits, the Más/Menos Info toggle and VOLVER (docs/spec.md § 5.3).
 *
 * From 48rem up it is the left column of the page and the collage takes the rest, as in the
 * Figma; below that it comes first and the collage goes under it.
 *
 * From 48rem up it stays pinned while the page scrolls, and the link of the part being read
 * turns red, so the panel works as an index of the page.
 *
 * The toggle is a button, not a link, because the spec is explicit that it must not change the
 * URL. With no JavaScript the panel stays in its "Más info" state, which is the one the page
 * starts in and the one that has the content in it, so nothing is lost — only the toggle is
 * inert.
 */
import { localePath, t, type Locale } from '../lib/i18n';
import type { ProjectData, ProjectPart } from '../lib/content';

interface Props {
  locale: Locale;
  data: ProjectData;
  parts: ProjectPart[];
}

const { locale, data, parts } = Astro.props;
const s = t(locale);
---

<div class="panel" data-enter-group>
  <h1 class="title" data-enter>
    {data.title}
  </h1>

  <div class="details" id="project-details" data-enter>
    {data.quote && <p class="quote">{data.quote}</p>}
    <p class="description">{data.description}</p>

    {parts.length > 0 && (
      <nav class="block" aria-labelledby="parts-heading">
        <h2 id="parts-heading">{s('project.parts')}</h2>
        <ul class="parts">
          {parts.map((part) => (
            <li>
              <a href={`#${part.id}`}>{part.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {data.credits.length > 0 && (
      <section class="block credits-block" aria-labelledby="credits-heading">
        <h2 id="credits-heading">{s('project.credits')}</h2>
        <dl class="credits">
          {data.credits.map((credit) => (
            <div class="credit">
              <dt>{credit.role}</dt>
              <dd>{credit.url ? <a href={credit.url}>{credit.name}</a> : credit.name}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </div>

  <p class="actions" data-enter>
    <button
      type="button"
      class="toggle"
      aria-expanded="true"
      aria-controls="project-details"
      data-more={s('project.moreInfo')}
      data-less={s('project.lessInfo')}
    >
      {s('project.lessInfo')}
    </button>
    <a class="back" href={localePath(locale, 'projects')}>
      {s('project.back')}
    </a>
  </p>
</div>

<script>
  import { animate } from 'motion/mini';

  /*
   * Más/Menos Info. "Menos Info" folds the details away — the description, "Partes del
   * proyecto" and the credits — leaving the title and the two actions, and lets the collage take
   * the whole screen; "Más Info" brings them back. Only opacity and transform move
   * (docs/spec.md § 8):
   *
   * - the blocks of the details slide out to the left and fade, one after another, and come
   *   back the same way; `hidden` is set once they are gone, so the panel closes up and screen
   *   readers skip them;
   * - each photo of the collage travels from its place in one layout to its place in the other
   *   (a FLIP: the new layout is applied at once, and a transform takes every image back to
   *   where it was and lets it go). The parallax writes the images' `transform` and the drift
   *   and the hover own `translate`, `rotate` and `scale`, so this one is *added* on top
   *   (`composite: 'add'`) instead of replacing any of them.
   *
   * With reduced motion the details fade and the collage simply switches.
   */
  const SLIDE = 24;
  const DURATION = 0.3;
  const STAGGER = 0.05;
  const TRAVEL = 700;
  const TRAVEL_STAGGER = 40;
  const EASE = [0.22, 1, 0.36, 1] as const;
  const EASE_CSS = 'cubic-bezier(0.22, 1, 0.36, 1)';

  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const details = document.getElementById('project-details');
  /* The page carries the state, so the layout (ProjectDetail.astro) can follow it. */
  const page = document.querySelector<HTMLElement>('.detail');
  const items = [...(page?.querySelectorAll<HTMLElement>('.collage .item') ?? [])];

  function reduced(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  /** Hands the elements back to CSS, a frame after the library writes its last values. */
  function release(elements: HTMLElement[]): void {
    requestAnimationFrame(() => {
      for (const element of elements) {
        element.style.removeProperty('opacity');
        element.style.removeProperty('transform');
      }
    });
  }

  /** The details, block by block, sliding out (`away`) or in, one after another. */
  function slide(blocks: HTMLElement[], away: boolean, still: boolean): Promise<unknown> {
    const hidden = still ? { opacity: 0 } : { opacity: 0, transform: `translateX(-${SLIDE}px)` };
    const shown = still ? { opacity: 1 } : { opacity: 1, transform: 'translateX(0px)' };
    const order = away ? [...blocks].reverse() : blocks;
    return Promise.all(
      order.map((block, index) =>
        animate(block, away ? hidden : shown, {
          duration: still ? DURATION / 2 : DURATION,
          ease: EASE,
          delay: still ? 0 : index * STAGGER,
        }),
      ),
    );
  }

  /** Moves every photo from where it was (`first`) to where the new layout put it. */
  function travel(first: DOMRect[]): Promise<unknown> {
    return Promise.all(
      items.map((item, index) => {
        const from = first[index];
        const to = item.getBoundingClientRect();
        if (!from || to.width === 0 || to.height === 0) return undefined;
        const dx = from.left + from.width / 2 - (to.left + to.width / 2);
        const dy = from.top + from.height / 2 - (to.top + to.height / 2);
        const sx = from.width / to.width;
        const sy = from.height / to.height;
        return item.animate(
          [
            { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
            { transform: 'translate(0px, 0px) scale(1, 1)' },
          ],
          {
            duration: TRAVEL,
            easing: EASE_CSS,
            delay: index * TRAVEL_STAGGER,
            fill: 'backwards',
            composite: 'add',
          },
        ).finished;
      }),
    );
  }

  if (toggle && details && page) {
    const { more = '', less = '' } = toggle.dataset;
    const blocks = [...details.children].filter(
      (child): child is HTMLElement => child instanceof HTMLElement,
    );
    let busy = false;

    toggle.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      const open = toggle.getAttribute('aria-expanded') === 'true';
      const still = reduced();

      toggle.setAttribute('aria-expanded', String(!open));
      toggle.textContent = open ? more : less;

      if (open) {
        await slide(blocks, true, still);
        const first = items.map((item) => item.getBoundingClientRect());
        details.hidden = true;
        page.dataset.info = 'less';
        if (!still) await travel(first);
      } else {
        const first = items.map((item) => item.getBoundingClientRect());
        for (const block of blocks) {
          block.style.opacity = '0';
          if (!still) block.style.transform = `translateX(-${SLIDE}px)`;
        }
        details.hidden = false;
        page.dataset.info = 'more';
        await Promise.all([slide(blocks, false, still), still ? undefined : travel(first)]);
      }

      release(blocks);
      busy = false;
      update();
    });
  }

  /*
   * The part being read. As the page scrolls, the link of the section that has reached the
   * upper part of the screen turns red (`aria-current`). Above the first section — on the
   * collage — none is marked. At the very bottom the last one is, even if it is too short to
   * reach the line.
   */
  const LINE = 0.35;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.parts a[href^="#"]')];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);

  function current(): HTMLElement | undefined {
    const atBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) return sections.at(-1);
    const line = window.innerHeight * LINE;
    return sections.filter((section) => section.getBoundingClientRect().top <= line).at(-1);
  }

  function update(): void {
    const id = current()?.id;
    for (const link of links) {
      if (link.hash === `#${id}`) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
  }

  /*
   * Straight from the scroll event, with no frame throttling: it measures at most three
   * sections and touches at most three attributes, which is less than a throttle costs to run.
   */
  if (sections.length > 0) {
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
  /*
   * 340px wide in the design, at x = 18 of a 1366 frame, which is how it clears the dice:
   * sideways, not by starting underneath it. The second term keeps that true on a screen
   * narrower than the one the design was drawn at — the panel never reaches the dice, which is
   * pinned to the middle.
   */
  .panel {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    min-width: 0;
  }

  /*
   * The width is worked out from the viewport, not from the panel's own column, which is sized
   * by the panel itself. Half the screen minus half the dice, the gutter and the page margin is
   * where the dice starts.
   *
   * A column that runs from top to bottom: the details take the room in between, and the
   * actions sit at the foot, Menos Info above VOLVER, both on the left (in the design they are
   * at y = 678 and 737 of 768, one under the other).
   */
  @media (width >= 48rem) {
    /*
     * x = 18 in the design, one step in from the page margin.
     *
     * Pinned while the page scrolls, and as tall as the screen below the nav row, so the
     * actions stay at its foot: VOLVER lands at about y = 726 of 768, where the design has it
     * (737). Content that does not fit scrolls inside the panel instead of being cut.
     */
    .panel {
      position: sticky;
      top: calc(var(--size-header-height) + var(--space-1));
      align-self: start;
      height: calc(100svh - var(--size-header-height) - var(--space-1) - var(--space-2));
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      padding-left: var(--space-1);
      width: min(
        21.25rem,
        calc(50vw - var(--size-dice-width) / 2 - var(--space-gutter) - var(--space-margin))
      );
    }

    .details {
      flex: 1;
    }
  }

  /* The title of a project is red, unlike every other heading (docs/spec.md § 5.3). */
  .title {
    color: var(--color-accent-text);
  }

  /*
   * The credits sit at the bottom of the panel: the design has a 190px flexible gap between the
   * part links and the Créditos heading, and the panel is 700 tall against a 768 frame.
   */
  .details {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  @media (width >= 48rem) {
    .details {
      display: flex;
      flex-direction: column;
    }

    /* Whatever is above it, the credits go to the bottom. The quote is optional, so counting
       rows would not survive a project without one. */
    .credits-block {
      margin-top: auto;
    }
  }

  .details[hidden] {
    display: none;
  }

  .quote {
    font-style: italic;
  }

  .block {
    display: grid;
    gap: var(--space-1);
  }

  /*
   * One link per line: in the design they are at y = 240, 257 and 274, a 17px step, which is
   * the line height of the body text. They are not a row.
   */
  .parts {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    /* The 17px step of the design is the body line height, not the prose one. */
    line-height: var(--lh-body);
  }

  /*
   * The part being read, set by the script below as the page scrolls. Red like every active
   * state on the site, with `aria-current` so it is not colour alone.
   */
  .parts a[aria-current='true'] {
    color: var(--color-accent-text);
  }

  .credits {
    display: grid;
    gap: 0;
    margin: 0;
    /* Credit rows are 17px in the design, the same step as the part links. */
    line-height: var(--lh-body);
  }

  /* Role and name on one line, the name starting at the same place down the column. */
  .credit {
    display: grid;
    grid-template-columns: minmax(6rem, max-content) 1fr;
    gap: 0 var(--space-gutter);
  }

  .credit dd {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-3);
    margin: 0;
  }

  /*
   * Below 48rem the panel is not pinned — it is the top of a long page — so the actions are:
   * a bar at the foot of the screen, on the page's black, with the toggle on the left and
   * VOLVER on the right. Otherwise Más Info would be a long scroll away once the details are
   * folded. The page already ends with more room than the bar takes (ProjectDetail.astro).
   */
  /*
   * No scrollbar flashing on load. The panel is exactly as tall as its content, and the
   * entrance starts every block 24px lower (src/scripts/motion.ts), so for 600 ms the content
   * spilled over and the panel's scrollbar came and went. Until the last block has arrived the
   * panel does not scroll. Only under `.motion`: without the script nothing is held back.
   */
  :global(.motion) .panel:not(:has(.actions[data-entered])) {
    overflow-y: hidden;
  }

  @media (width < 48rem) {
    .actions {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 2;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-gutter);
      padding: var(--space-1) var(--space-margin);
      background: var(--color-bg);
    }
  }

  @media (width >= 48rem) {
    .actions {
      margin-top: auto;
      padding-top: var(--space-2);
    }
  }

  .toggle,
  .back {
    font-weight: var(--fw-bold);
    text-decoration: underline;
  }

  .toggle:hover,
  .back:hover {
    color: var(--color-accent-text);
  }
</style>
