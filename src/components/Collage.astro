---
/**
 * The collage (docs/spec.md § 7, ADR 0005). `src/lib/collage.ts` decides where everything goes
 * at build time; this only turns the numbers into CSS.
 *
 * Three layouts come out of the algorithm — four columns, two columns, and four columns across
 * the whole screen for a project page in its "Menos info" state — and each image carries all
 * of them as custom properties. The media query and the page's `data-info` pick a set. That way
 * a single element per image serves every case, there is no layout JavaScript, and nothing
 * moves after paint.
 *
 * `alt` is the caller's call. On a project page the same photographs are listed again under the
 * collage with their real alt text, so there they come in empty and a screen reader hears each
 * one once.
 */
import { Image } from 'astro:assets';
import { collage, type CollageImage, type CollageItem } from '../lib/collage';

interface Props {
  items: CollageItem[];
  /** The slug plus the entry's `collageSeed`; the same string always gives the same collage. */
  seed: string;
}

const { items, seed } = Astro.props;

const images: CollageImage[] = items.map(({ image }) => ({ aspect: image.width / image.height }));
const layout = collage(images, seed);

/** The placements come back indexed, so each item finds its own in every layout. */
const positioned = items.flatMap((item, index) => {
  const wide = layout.wide.find((placement) => placement.index === index);
  const narrow = layout.narrow.find((placement) => placement.index === index);
  const full = layout.full.find((placement) => placement.index === index);
  return wide && narrow && full ? [{ item, wide, narrow, full }] : [];
});

const round = (value: number): string => `${value.toFixed(3)}%`;

/**
 * The idle drift of one image, worked out from its position in the collage and nothing else
 * (docs/spec.md § 8). No `Math.random` anywhere near this: the same collage has to breathe the
 * same way on every build, or the HTML changes on every deploy for no reason.
 *
 * The three prime-ish steps are there so the loops fall out of sync with each other and the
 * collage never pulses as one block. The delay is negative, which starts each image partway
 * into its own loop instead of having them all set off together on load.
 */
function drift(index: number): string {
  const seconds = 8 + (index % 5); // 8–12 s, as the spec asks
  const delay = -((index * 1.7) % seconds);
  const x = index % 2 === 0 ? 6 : -6; // ±6 px
  const y = index % 3 === 0 ? -6 : 6;
  const turn = index % 2 === 0 ? -0.6 : 0.6; // ±0.6°

  return [
    `--drift-duration: ${seconds}s`,
    `--drift-delay: ${delay.toFixed(2)}s`,
    `--drift-x: ${x}px`,
    `--drift-y: ${y}px`,
    `--drift-rotate: ${turn}deg`,
  ].join('; ');
}
---

{positioned.length > 0 && (
  <div
    class="collage"
    data-enter-group
    data-fallback={layout.fallback ? '' : undefined}
    style={`--wide-aspect: ${layout.wideAspect.toFixed(4)}; --narrow-aspect: ${layout.narrowAspect.toFixed(4)}; --full-aspect: ${layout.fullAspect.toFixed(4)};`}
  >
    {positioned.map(({ item, wide, narrow, full }, index) => (
      <Image
        class="item"
        data-enter
        src={item.image}
        alt={item.alt}
        widths={[320, 640, 960]}
        sizes="(width >= 48rem) 50vw, 100vw"
        loading="lazy"
        style={[
          `--x: ${round(wide.x)}`,
          `--y: ${round(wide.y)}`,
          `--w: ${round(wide.width)}`,
          `--h: ${round(wide.height)}`,
          `--nx: ${round(narrow.x)}`,
          `--ny: ${round(narrow.y)}`,
          `--nw: ${round(narrow.width)}`,
          `--nh: ${round(narrow.height)}`,
          `--fx: ${round(full.x)}`,
          `--fy: ${round(full.y)}`,
          `--fw: ${round(full.width)}`,
          `--fh: ${round(full.height)}`,
          `object-position: ${item.focus}`,
          drift(index),
        ].join('; ')}
      />
    ))}
  </div>
)}

<style>
  /*
   * The box keeps the shape the algorithm laid the cells out in, so the percentages inside it
   * mean what they meant when they were computed, and the height is known before the images
   * load.
   */
  .collage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--narrow-aspect);
  }

  .item {
    position: absolute;
    left: var(--nx);
    top: var(--ny);
    width: var(--nw);
    height: var(--nh);
    /* The cell decides the shape, so the photograph is cropped to it, from `focus`. */
    object-fit: cover;
    /*
     * The design shows images at 70% over the background, which is what the token is for. It
     * also happens to be what makes the panel readable where it sits over the collage: the
     * body text against the placeholder colour is 4.03:1 at full opacity, which fails AA, and
     * 6.70:1 at 70%, which passes.
     *
     * Whether real photographs keep this is still an open decision (CLAUDE.md). The contrast
     * figures above are the cost of dropping it, and a real photograph is not one flat colour,
     * so if it goes, the panel will want a scrim behind the text instead.
     */
    opacity: var(--opacity-placeholder);

    /*
     * The idle drift (docs/spec.md § 8). It uses the `translate` and `rotate` properties rather
     * than `transform`, so that it composes with anything written to `transform` instead of
     * overwriting it — the entrance animation writes there, and so will the parallax.
     *
     * `alternate` means one set of keyframes covers the way out and the way back, so the image
     * never jumps at the end of a loop.
     */
    animation: drift var(--drift-duration) var(--drift-delay) ease-in-out infinite alternate;
  }

  @keyframes drift {
    from {
      translate: 0 0;
      rotate: 0deg;
    }
    to {
      translate: var(--drift-x) var(--drift-y);
      rotate: var(--drift-rotate);
    }
  }

  /*
   * Paused off screen and with the tab hidden, which the spec asks for and which keeps a long
   * page of collages from animating a dozen images nobody is looking at. The class is set by
   * src/scripts/motion.ts; the browser throttles hidden tabs anyway, but not reliably.
   */
  .collage[data-still] .item {
    animation-play-state: paused;
  }

  /* No idle motion when the visitor asked for less. */
  @media (prefers-reduced-motion: reduce) {
    .item {
      animation: none;
    }
  }

  @media (width >= 48rem) {
    .collage {
      aspect-ratio: var(--wide-aspect);
    }

    .item {
      left: var(--x);
      top: var(--y);
      width: var(--w);
      height: var(--h);
    }

    /*
     * A project page in its "Menos info" state (ProjectDetail.astro sets `data-info`): the
     * collage spans the whole screen with the third layout, which keeps the title, the dice
     * and the two actions clear.
     */
    :global([data-info='less']) .collage {
      aspect-ratio: var(--full-aspect);
    }

    :global([data-info='less']) .item {
      left: var(--fx);
      top: var(--fy);
      width: var(--fw);
      height: var(--fh);
    }
  }
</style>
