---
import '../styles/global.css';
import Dice from '../components/Dice.astro';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import { DEFAULT_LOCALE, LOCALES, localeVariants, type Locale, type Page } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** The page being shown, marked as active in the nav. */
  current?: Page;
  /** Keeps the page out of search engines: the styles page, the 404, the previews. */
  noindex?: boolean;
}

const { locale, title, description, current, noindex = false } = Astro.props;

/** The same page in the other locale, for `hreflang` (docs/spec.md § 10). */
const variants = localeVariants(Astro.url.pathname);
/** Absolute once `site` is configured; the final domain is still open (docs/spec.md § 13). */
const absolute = (path: string): string => (Astro.site ? new URL(path, Astro.site).href : path);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {LOCALES.map((item) => (
      <link rel="alternate" hreflang={item} href={absolute(variants[item])} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(variants[DEFAULT_LOCALE])} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <Header locale={locale} current={current} />
      <Dice />
      <main class="main">
        <slot />
      </main>
      <Logo />
    </div>
  </body>
</html>

<style>
  .shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
  }

  .main {
    min-width: 0;
    padding: 0 var(--space-margin);
  }
</style>
