---
import '../styles/global.css';
import Dice from '../components/Dice.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import Header from '../components/Header.astro';
import LocaleSwitch from '../components/LocaleSwitch.astro';
import Logo from '../components/Logo.astro';
import { DEFAULT_LOCALE, LOCALES, localeVariants, type Locale, type Page } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** The page being shown, marked as active in the nav. */
  current?: Page;
  /**
   * Keeps the page out of search engines: the styles page, the 404, the previews, and the pages
   * that are still placeholders. Such a page gets no canonical either, and must stay out of
   * `src/pages/sitemap.xml.ts`.
   */
  noindex?: boolean;
  /**
   * `full` is the nav row of every built page. `switch-only` drops it and keeps just `ES/EN`,
   * for the holding page, where the pages the nav points at are not built yet.
   */
  chrome?: 'full' | 'switch-only';
  /** Where the dice sits. The holding page is the one that wants it big and in the flow. */
  dice?: 'nav' | 'hero';
}

const {
  locale,
  title,
  description,
  current,
  noindex = false,
  chrome = 'full',
  dice = 'nav',
} = Astro.props;

/** The same page in the other locale, for `hreflang` (docs/spec.md § 10), and its canonical. */
const variants = localeVariants(Astro.url.pathname);

const site = Astro.site;
if (!site) {
  throw new Error(
    '`site` must be set in astro.config.mjs: hreflang and canonical need absolute URLs',
  );
}

/**
 * Absolute, from the paths `localePath` builds: no trailing slash except on the two home pages.
 * `public/.htaccess` serves exactly that shape and redirects the other one, so no canonical or
 * `hreflang` here ever points at a URL that redirects.
 */
const absolute = (path: string): string => new URL(path, site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <GoogleTagManager part="head" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={absolute(variants[locale])} />
    )}
    {LOCALES.map((item) => (
      <link rel="alternate" hreflang={item} href={absolute(variants[item])} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(variants[DEFAULT_LOCALE])} />
    <title>{title}</title>
  </head>
  <body>
    <GoogleTagManager part="body" />
    <div class:list={['shell', `dice-${dice}`]}>
      {chrome === 'full' ? (
        <Header locale={locale} current={current} />
      ) : (
        <div class="switch-only">
          <LocaleSwitch locale={locale} />
        </div>
      )}
      {dice === 'nav' && <Dice />}
      <main class="main">
        <slot />
      </main>
      <div class="footer">
        <Logo />
      </div>
    </div>
  </body>
</html>

<style>
  .shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
  }

  .main {
    min-width: 0;
    padding: 0 var(--space-margin);
  }

  /* The `ES/EN`-only row stands in for the nav, on the same baseline as it (Header.astro). */
  .switch-only {
    display: flex;
    justify-content: flex-end;
    padding: 6px var(--space-margin);
    font-size: var(--fs-nav);
    line-height: var(--lh-nav);
  }

  /*
   * On a wide screen the dice sits beside the content, as in the design. On a narrow one the
   * content is full width, so the page leaves room for the dice above it. Only needed when the
   * dice is pinned over the content; the hero one is in the flow and makes its own room.
   */
  @media (width < 48rem) {
    .dice-nav .main {
      padding-top: calc(var(--size-dice-height) + var(--space-1));
    }
  }

  .footer {
    display: flex;
    justify-content: center;
    padding: var(--space-2) var(--space-margin);
  }
</style>
