---
import HomePlaceholder from '../components/HomePlaceholder.astro';
import Base from '../layouts/Base.astro';
import { getGeneral } from '../lib/content';
import { DEFAULT_LOCALE } from '../lib/i18n';

const locale = DEFAULT_LOCALE;
const { seo } = await getGeneral(locale);
---

<Base locale={locale} title={seo.title} description={seo.description}>
  <HomePlaceholder locale={locale} />
</Base>
