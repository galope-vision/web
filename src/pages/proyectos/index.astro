---
/* `noindex` while this is a placeholder: a thin page in the results now would have to be
   cleaned out later. Drop it, and add the page back to src/pages/sitemap.xml.ts, when it
   holds real content. */
import Placeholder from '../../components/Placeholder.astro';
import Base from '../../layouts/Base.astro';
import { getGeneral } from '../../lib/content';
import { t, type Locale } from '../../lib/i18n';

const locale: Locale = 'es';
const { seo } = await getGeneral(locale);
const title = t(locale)('page.projects');
---

<Base
  locale={locale}
  current="projects"
  noindex
  title={`${title} · ${seo.title}`}
  description={seo.description}
>
  <Placeholder locale={locale} title={title} />
</Base>
