---
/* `noindex` until the real projects are loaded: the only entries right now are the samples of
   src/content/proyectos/muestra-*, and a page of invented projects in the results would have to
   be cleaned out later. Drop it, and add the page back to src/pages/sitemap.xml.ts, once the
   content is Galope's. */
import ProjectList from '../../components/ProjectList.astro';
import Base from '../../layouts/Base.astro';
import { getGeneral, getProjects } from '../../lib/content';
import { t, type Locale } from '../../lib/i18n';

const locale: Locale = 'es';
const { seo } = await getGeneral(locale);
const projects = await getProjects(locale);
const title = t(locale)('page.projects');
---

<Base
  locale={locale}
  current="projects"
  noindex
  title={`${title} · ${seo.title}`}
  description={seo.description}
>
  {/* The design shows no page title here: the nav already says where you are. */}
  <h1 class="visually-hidden">{title}</h1>
  <ProjectList locale={locale} projects={projects} />
</Base>
