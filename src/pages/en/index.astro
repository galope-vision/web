---
import ComingSoon from '../../components/ComingSoon.astro';
import Base from '../../layouts/Base.astro';
import { getGeneral } from '../../lib/content';
import { t, type Locale } from '../../lib/i18n';

const locale: Locale = 'en';
const { seo, socials } = await getGeneral(locale);
const s = t(locale);
---

{/*
  The holding page, until phase 3 builds the real home (the random images or video of
  docs/spec.md § 5.1). Then this goes back to `<Base chrome="full" dice="nav">` with the home
  content in it, and `ComingSoon.astro` is deleted.
*/}
<Base
  locale={locale}
  title={`${seo.title} · ${s('soon.title')}`}
  description={seo.description}
  chrome="switch-only"
  dice="hero"
>
  <ComingSoon socials={socials} />
</Base>
