---
/* `noindex` while this is a placeholder: a thin page in the results now would have to be
   cleaned out later. Drop it, and add the page back to src/pages/sitemap.xml.ts, when it
   holds real content. */
import Contact from '../components/Contact.astro';
import Base from '../layouts/Base.astro';
import { getGeneral } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

const locale: Locale = 'es';
const { email, socials, seo } = await getGeneral(locale);
const title = t(locale)('page.contact');
---

<Base
  locale={locale}
  current="contact"
  noindex
  title={`${title} · ${seo.title}`}
  description={seo.description}
>
  <h1 class="visually-hidden">{title}</h1>
  <Contact email={email} socials={socials} />
</Base>
