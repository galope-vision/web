---
/**
 * The site's 404 (docs/spec.md § 5.7). Apache serves it through .htaccess, so there is one page
 * for the whole site and it is in Spanish, the default locale.
 */
import Base from '../layouts/Base.astro';
import { getGeneral } from '../lib/content';
import { DEFAULT_LOCALE, localePath, t } from '../lib/i18n';

const locale = DEFAULT_LOCALE;
const { seo } = await getGeneral(locale);
const s = t(locale);
---

<Base
  locale={locale}
  noindex
  title={`${s('notFound.title')} · ${seo.title}`}
  description={seo.description}
>
  <div class="not-found">
    <h1>{s('notFound.title')}</h1>
    <a href={localePath(locale, 'home')}>{s('notFound.back')}</a>
  </div>
</Base>

<style>
  .not-found {
    display: grid;
    place-content: center;
    gap: var(--space-1);
    height: 100%;
    text-align: center;
  }
</style>
