# Environment variables used by the build.
# Document every new variable here with a short comment, and keep real values out of the repo.
# Deploy credentials (FTP, Cloudflare) live in GitHub Actions secrets, not in this file.

# Google Tag Manager container (ADR 0008), e.g. GTM-W5Q3RH53. Set it ONLY for the production
# build: when it is empty, no tag is rendered (dev, CI, Cloudflare Pages previews).
PUBLIC_GTM_ID=
