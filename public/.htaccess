# Apache settings for the DonWeb shared hosting (ADR 0003). This file ships inside dist/, so a
# change here goes live with the next deploy. Every block is guarded: a module this plan does
# not have must be ignored, not turn the whole site into a 500.

# ── One canonical host ────────────────────────────────────────────────────────────────────
# The account answers on http and https, with and without www, so the same page has four URLs
# and search engines pick one of them for us. These two rules make it one: https, no www.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Both conditions have to hold, so that a plan where TLS is terminated upstream (and %{HTTPS}
  # is off even though the visitor arrived over https) does not end in a redirect loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://ga-lo-pe.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Astro fingerprints everything under /_astro/, so those files can be cached forever.
  RewriteRule ^_astro/ - [E=FINGERPRINTED:1]
</IfModule>

# ── 404 ───────────────────────────────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Caching ───────────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Cache-Control "public, max-age=31536000, immutable" env=FINGERPRINTED
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML is never cached: a deploy has to be visible immediately.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/avif "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  # robots.txt and the sitemap change when the site does.
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript image/svg+xml
</IfModule>
